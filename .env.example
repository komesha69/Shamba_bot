# Flask Configuration
FLASK_ENV=production
SECRET_KEY=your-production-flask-secret-key
JWT_SECRET_KEY=your-production-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=480

# Database Configuration (MariaDB / MySQL SQLAlchemy URI)
# Format: mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql+pymysql://shamba_user:your_password@localhost:3306/shamba_db

# Individual DB fields (alternative if DATABASE_URL is not set directly)
DB_HOST=localhost
DB_PORT=3306
DB_USER=shamba_user
DB_PASSWORD=your_password
DB_NAME=shamba_db

# Initial Seed Configuration
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_EMAIL=admin@mpelabushifarms.com
ADMIN_DEFAULT_PASSWORD=ChangeThisStrongPass123!
ADMIN_DEFAULT_NAME=System Administrator

# Server & Network
PORT=3000
BACKEND_PORT=5000
